# LLM API Keys (Google Gemini is the default primary provider)
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL=gemini-3.6-flash
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_LLM_PROVIDER=gemini

# Code Execution Sandbox (docker is free local default, e2b is optional cloud)
EXECUTION_PROVIDER=docker
E2B_API_KEY=

# Database & Redis (PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./recruitment_system.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitment_db
REDIS_URL=redis://localhost:6379/0

# App Settings
APP_NAME=Multi-Agent AI Recruitment Assessment System
DEBUG=True
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
